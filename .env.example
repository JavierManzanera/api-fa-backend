PROJECT_NAME="FastAPI Headless Auth"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db_name
# TLS to PostgreSQL (audit finding #8). One of: disable | require | verify-full.
# "verify-full" (encrypt + verify server cert + hostname) is recommended for
# anything beyond local dev -- the only mode that protects against a
# man-in-the-middle presenting an untrusted/self-signed certificate.
# "require" encrypts the connection but does NOT verify the server's
# certificate or hostname -- it stops passive eavesdropping but is VULNERABLE
# to an active MITM attacker presenting a forged/self-signed certificate on
# the wire (e.g. a rogue transparent proxy or DNS-spoofed endpoint). Only use
# "require" as a deliberate, informed trade-off (e.g. a private network you
# already trust) -- never treat it as equivalent to "verify-full" just
# because both "enable TLS". "disable" is the explicit local/test opt-out
# (e.g. this template's own throwaway test Postgres, or a same-host/Unix-
# socket deployment where TLS doesn't apply). Required -- no default.
POSTGRES_SSL_MODE=verify-full

# Optional (audit finding #18 -- docs/database/obj-012-tls-dast-verification.md
# Finding 1). Path to a CA certificate file that "verify-full" should trust
# IN PLACE OF the OS's default trust store (audit finding #19: this
# replaces it for the connection, it does not merge with it -- pinning a
# private CA here means that connection no longer trusts the OS's public
# CAs either). Leave unset if your Postgres server's certificate already
# chains to a publicly-trusted CA (or one your OS already trusts) -- unset
# preserves today's default behavior exactly. Set this when self-hosting
# Postgres with a private/internal CA: without it, "verify-full" fails
# closed against a self-signed/private-CA cert (correct behavior -- it's
# not a trusted certificate), which otherwise leaves self-hosted operators
# no safe option beyond the weaker, MITM-vulnerable "require" mode.
# Example: /etc/ssl/certs/my-private-ca.pem
POSTGRES_SSL_ROOT_CERT=

# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters and not a known placeholder (app refuses to start otherwise).
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OBJ-004: HTTP Security Baseline (audit findings #9, #10, #13) ---
# See docs/api/obj-004-design-notes.md for the full rationale behind every
# field below -- this section is Gate-1-pending as of this pass; values here
# reflect the solution-architect's RECOMMENDED defaults, not yet user-approved.

# One of: development | staging | production. Required -- no default, same
# "every environment must say what it wants" convention as POSTGRES_SSL_MODE.
# Gates /docs, /redoc, /openapi.json (disabled when production) and is
# available for future objectives to branch on.
ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call this API
# cross-origin (e.g. https://app.example.com,https://admin.example.com).
# Defaults to empty (no browser origin allowed) if unset -- this is a
# deliberate fail-closed default (design notes section 1.6), not an
# oversight. Never set this to "*" -- it is not even a valid entry (each
# value must parse as a full http(s) URL), by design.
BACKEND_CORS_ORIGINS=

# Comma-separated list of Host header values this API will accept (defends
# against Host-header-injection-based cache poisoning / vhost confusion).
# Defaults to "*" (accepts any Host, today's existing behavior) -- tighten
# this to your real deployment hostname(s) in production.
ALLOWED_HOSTS=*

# How many trusted reverse proxies/load balancers sit in front of this app.
# 0 (default) = do NOT trust the X-Forwarded-For header at all; use the
# direct socket peer address. Only raise this if you control every hop
# between the client and this app up to that count -- blindly trusting
# X-Forwarded-For with no fronting proxy lets a client spoof its own IP and
# defeat rate limiting entirely (design notes section 6).
TRUSTED_PROXY_COUNT=0

# Python logging level for structured auth-event logs (design notes section
# 4). One of the standard logging levels, e.g. DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
